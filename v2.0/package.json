{
  "name": "codebattlearena",
  "version": "1.0.0",
  "description": "The base package for this project",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "test": "node server/testAptitude.js",
    "test:aptitude": "node server/testAptitude.js",
    "verify": "node -c server/index.js server/database.js server/aptitudeDatabase.js && node server/testAptitude.js",
    "seed": "node server/seedDatabase.js",
    "lint": "eslint server/ client/ --ext .js --max-warnings 50",
    "build": "echo \"Build step - verifying files exist\" && node -c server/index.js",
    "health": "node -e \"fetch('http://localhost:8080/api/health').then(r => r.ok ? process.exit(0) : process.exit(1)).catch(() => process.exit(1))\"",
    "setup-hooks": "git config core.hooksPath ../.githooks"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vikashgupta16/CodeBattle-Arena.git"
  },
  "keywords": [
    "express",
    "ws",
    "dotenv"
  ],
  "author": "Rouvik Maji Archisman Pal Vikash Gupta Rajbeer Saha",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/Vortex-16/CodeBattle-Arena/issues"
  },
  "homepage": "https://github.com/Vortex-16/CodeBattle-Arena#readme",
  "dependencies": {
    "@clerk/express": "^1.3.59",
    "@google/generative-ai": "^0.2.1",
    "cookie-session": "^2.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "mongoose": "^8.13.1",
    "node-fetch": "^3.3.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.0",
    "eslint": "^8.57.0"
  }
}