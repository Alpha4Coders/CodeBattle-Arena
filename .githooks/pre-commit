#!/usr/bin/env bash
# ==============================================================================
# CodeBattle Arena - Pre-commit DevOps Quality Gate
# Ensures syntax, tests, and code quality pass before a commit can be created.
# ==============================================================================

echo "========================================================"
echo "🛡️  Running CodeBattle Arena Pre-Commit Quality Checks..."
echo "========================================================"

# Navigate to v2.0 directory if it exists
if [ -d "v2.0" ]; then
    cd v2.0
fi

# 1. Syntax Verification
echo "🔍 [1/3] Checking core server syntax..."
node -c server/index.js || { echo "❌ Syntax error in server/index.js"; exit 1; }
node -c server/database.js || { echo "❌ Syntax error in server/database.js"; exit 1; }
node -c server/aptitudeDatabase.js || { echo "❌ Syntax error in server/aptitudeDatabase.js"; exit 1; }
node -c server/seedAptitude.js || { echo "❌ Syntax error in server/seedAptitude.js"; exit 1; }
echo "✅ Syntax checks passed."

# 2. Automated SDE Test Suite
echo "🧪 [2/3] Running Aptitude & System Unit Tests..."
node server/testAptitude.js || {
    echo "❌ Local tests failed! Fix failing tests before committing.";
    exit 1;
}
echo "✅ All tests passed."

# 3. Environment & Security Check
echo "🔒 [3/3] Checking environment & secrets safety..."
if git diff --cached --name-only | grep -E '\.env$'; then
    echo "❌ SECURITY ALERT: Attempting to commit a raw .env file containing secrets!";
    echo "Please unstage .env and use .env.example instead.";
    exit 1;
fi

echo "========================================================"
echo "🎉 All local pre-commit checks PASSED! Commit proceeding."
echo "========================================================"
exit 0
